APP_NAME=DataAssistant
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-use-long-random-string

MAX_FILE_SIZE=10MB
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs

LOG_LEVEL=INFO

OPENAI_API_KEY=your_api_key
# gpt-4o — лучше для скринов графиков; gpt-4o-mini — дешевле для таблиц
OPENAI_MODEL=gpt-4o
OPENAI_MAX_HISTORY_MESSAGES=8

LLM_PROVIDER=openai
# financial_analyst | marketer | market_trading_analyst (crypto, stocks, forex)
PROMPT_ROLE=market_trading_analyst

DATABASE_PATH=storage/data_assistant.db

# Optional: require X-API-Key header for all routes
# API_AUTH_KEY=your-secret-api-key

RATE_LIMIT_PER_MINUTE=30
STORAGE_TTL_DAYS=7
DOWNLOAD_TOKEN_TTL_SECONDS=3600
ENABLE_STORAGE_CLEANUP=true
